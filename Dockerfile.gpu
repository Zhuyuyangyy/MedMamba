# =============================================================================
# MedMamba Dockerfile - GPU版本 (CUDA)
# =============================================================================
# 使用: docker build -f Dockerfile.gpu -t medmamba:gpu .
# 运行: docker run --gpus all -it --rm -p 8866:8866 medmamba:gpu

FROM nvidia/cuda:11.8-cudnn8-runtime-ubuntu22.04

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# 安装系统依赖和Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# 设置Python 3.10为默认
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# 工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements.txt .

# 安装Python依赖 (使用国内镜像加速)
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt || \
    pip install --no-cache-dir -r requirements.txt

# 复制项目代码
COPY . .

# 暴露端口
EXPOSE 8866

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8866/health')" || exit 1

# 默认命令: 启动API服务
CMD ["python", "src/api/server.py"]

# =============================================================================
# 使用示例:
#
# 1. 构建镜像:
#    docker build -f Dockerfile.gpu -t medmamba:gpu .
#
# 2. 运行容器 (GPU支持):
#    docker run --gpus all -it --rm \
#      -p 8866:8866 \
#      -v $(pwd)/weights:/app/weights \
#      medmamba:gpu
#
# 3. 训练时挂载数据:
#    docker run --gpus all -it --rm \
#      -p 8866:8866 \
#      -v $(pwd)/weights:/app/weights \
#      -v /path/to/data:/data \
#      medmamba:gpu python train_medmamba.py --data /data
#
# 4. 使用docker-compose (见 docker-compose.yml)
# =============================================================================